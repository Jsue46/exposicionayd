="1"><mxGeometry x="280" y="96" width="300" height="46" as="geometry"/></mxCell><mxCell id="6" value="Disponibilidad y continuidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="142" width="240" height="88" as="geometry"/></mxCell><mxCell id="7" value="La capa de negocio se despliega en servidor aplicativo con monitoreo, backups y operación incremental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="142" width="300" height="88" as="geometry"/></mxCell><mxCell id="8" value="Desempeño" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="240" height="88" as="geometry"/></mxCell><mxCell id="9" value="Se separan presentación, servicios, negocio, datos e integración para evitar concentrar toda la carga en un solo punto lógico." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="230" width="300" height="88" as="geometry"/></mxCell><mxCell id="10" value="Usabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="240" height="88" as="geometry"/></mxCell><mxCell id="11" value="El usuario accede desde navegador web o móvil mediante portal académico y campus virtual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontSty