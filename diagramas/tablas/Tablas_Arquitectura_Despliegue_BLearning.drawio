Space=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="582" width="300" height="88" as="geometry"/></mxCell><mxCell id="18" value="Trazabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="240" height="88" as="geometry"/></mxCell><mxCell id="19" value="La BD centralizada conserva evidencia académica, reportes, certificación y KPI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="670" width="300" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
