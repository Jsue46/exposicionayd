uales." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="566" width="760" height="82" as="geometry"/></mxCell><mxCell id="18" value="Trazabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="648" width="260" height="82" as="geometry"/></mxCell><mxCell id="19" value="La BD centralizada conserva evidencia académica, reportes, certificación y KPI." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="648" width="760" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
