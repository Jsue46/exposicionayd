<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="tbl1" name="Primera descomposicion propuesta"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Primera descomposicion propuesta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F3A33" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1115" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFA;strokeColor=#B7D7C2;arcSize=6;shadow=1" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1155" height="606" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="102" width="135" height="54" as="geometry"/></mxCell><mxCell id="5" value="Macroproceso de negocio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="102" width="300" height="54" as="geometry"/></mxCell><mxCell id="6" value="Justificacion en el caso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="102" width="680" height="54" as="geometry"/></mxCell><mxCell id="7" value="CUN-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="156" width="135" height="86" as="geometry"/></mxCell><mxCell id="8" value="Diseñar y actualizar la oferta formativa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="156" width="300" height="86" as="geometry"/></mxCell><mxCell id="9" value="El programa define objetivos, destinatarios, contenidos, cursos, diplomaturas, programas y actualizaciónes anuales según demandas del entorno." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="156" width="680" height="86" as="geometry"/></mxCell><mxCell id="10" value="CUN-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="242" width="135" height="86" as="geometry"/></mxCell><mxCell id="11" value="Captar e inscribir alumnos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="242" width="300" height="86" as="geometry"/></mxCell><mxCell id="12" value="Continuar.UNS difunde la propuesta, atiende interesados, gestióna inscripciónes y administra información académica y administrativa de alumnos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="242" width="680" height="86" as="geometry"/></mxCell><mxCell id="13" value="CUN-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="328" width="135" height="86" as="geometry"/></mxCell><mxCell id="14" value="Producir contenidos y recursos educativos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="328" width="300" height="86" as="geometry"/></mxCell><mxCell id="15" value="Docentes, coordinadores, diseno grafico y produccion audiovisual elaboran materiales, actividades, articulos, videos y recursos para la modalidad b-learning." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="328" width="680" height="86" as="geometry"/></mxCell><mxCell id="16" value="CUN-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="414" width="135" height="86" as="geometry"/></mxCell><mxCell id="17" value="Administrar plataforma y servicio EaD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="414" width="300" height="86" as="geometry"/></mxCell><mxCell id="18" value="El programa depende de la gestión del LMS, alojamiento de cursos, comunicación docente-alumno, administración de usuarios y soporte tecnológico educativo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="414" width="680" height="86" as="geometry"/></mxCell><mxCell id="19" value="CUN-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="135" height="86" as="geometry"/></mxCell><mxCell id="20" value="Impartir, evaluar y certificar cursos b-learning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="500" width="300" height="86" as="geometry"/></mxCell><mxCell id="21" value="Los docentes acompañan, orientan, responden dudas, promueven participacion, evalúan actividades, foros y trabajos finales; la certificación acredita formalmente el resultado obtenido por los alumnos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="500" width="680" height="86" as="geometry"/></mxCell><mxCell id="22" value="CUN-06" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="586" width="135" height="86" as="geometry"/></mxCell><mxCell id="23" value="Analizar resultados y mejorar el programa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="586" width="300" height="86" as="geometry"/></mxCell><mxCell id="24" value="La evaluación decenal, los reportes estadísticos, la deserción, la cobertura geográfica y la innovación tecnológica guian la mejora continua del programa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="586" width="680" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tbl2" name="Stakeholders directos considerados"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="836" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Stakeholders directos considerados" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F3A33" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1115" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFA;strokeColor=#B7D7C2;arcSize=6;shadow=1" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1155" height="692" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="102" width="135" height="54" as="geometry"/></mxCell><mxCell id="5" value="Stakeholder directo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="102" width="300" height="54" as="geometry"/></mxCell><mxCell id="6" value="Macroprocesos relacionados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="102" width="680" height="54" as="geometry"/></mxCe