<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="tbl1" name="Drivers de restricción"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1008" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Drivers de restricción" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F3A33" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1115" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFA;strokeColor=#B7D7C2;arcSize=6;shadow=1" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1155" height="864" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="102" width="135" height="54" as="geometry"/></mxCell><mxCell id="5" value="Tipo de restricción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="102" width="300" height="54" as="geometry"/></mxCell><mxCell id="6" value="Descripción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="102" width="680" height="54" as="geometry"/></mxCell><mxCell id="7" value="RES-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="156" width="135" height="86" as="geometry"/></mxCell><mxCell id="8" value="Del negocio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="156" width="300" height="86" as="geometry"/></mxCell><mxCell id="9" value="La solución debe mantener la modalidad b-learning del programa, combinando actividades presenciales no obligatorias con clases virtuales." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="156" width="680" height="86" as="geometry"/></mxCell><mxCell id="10" value="RES-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="242" width="135" height="86" as="geometry"/></mxCell><mxCell id="11" value="Operativa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="242" width="300" height="86" as="geometry"/></mxCell><mxCell id="12" value="Los programas a distancia actuales deben seguir funcionando durante cualquier mejora, migración o crecimiento de la plataforma." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="242" width="680" height="86" as="geometry"/></mxCell><mxCell id="13" value="RES-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="328" width="135" height="86" as="geometry"/></mxCell><mxCell id="14" value="De crecimiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="328" width="300" height="86" as="geometry"/></mxCell><mxCell id="15" value="La solución debe permitir incorporar al menos 3 programas existentes de licenciatura y 3 de posgrado por cada ciclo académico anual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="328" width="680" height="86" as="geometry"/></mxCell><mxCell id="16" value="RES-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="414" width="135" height="86" as="geometry"/></mxCell><mxCell id="17" value="Tecnológica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="414" width="300" height="86" as="geometry"/></mxCell><mxCell id="18" value="La solución debe considerar la plataforma LMS institucional utilizada por Continuar.UNS para alojar cursos, administrar usuarios y comunicar docentes con alumnos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="414" width="680" height="86" as="geometry"/></mxCell><mxCell id="19" value="RES-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="135" height="86" as="geometry"/></mxCell><mxCell id="20" value="Tecnológica / estándares" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="500" width="300" height="86" as="geometry"/></mxCell><mxCell id="21" value="La plataforma debe conservar compatibilidad con capacidades educativas como SCORM, AICC, manejo de contenidos, metadatos, foros, correo, chat y administración de usuarios." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="500" width="680" height="86" as="geometry"/></mxCell><mxCell id="22" value="RES-06" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="586" width="135" height="86" as="geometry"/></mxCell><mxCell id="23" value="Pedagógica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="586" width="300" height="86" as="geometry"/></mxCell><mxCell id="24" value="La solución debe respetar la lógica de educación a distancia, priorizando flexibilidad, comunicación asincrónica y gestión del tiempo didáctico virtual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="586" width="680" height="86" as="geometry"/></mxCell><mxCell id="25" value="RES-07" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="672" width="135" height="86" as="geometry"/></mxCell><mxCell id="26" value="Institucional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="672" width="300" height="86" as="geometry"/></mxCell><mxCell id="27" value="La solución debe alinearse con la estrategia de la UNS de fortalecer la educación a distancia como eje institucional." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="672" width="680" height="86" as="geometry"/></mxCell><mxCell id="28" value="RES-08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="758" width="135" height="86" as="geometry"/></mxCell><mxCell id="29" value="Organizacional" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="758" width="300" height="86" as="geometry"/></mxCell><mxCell id="30" value="La solución debe operar dentro de un esquema de trabajo multidisciplinario formado por coordinación académica, Continuar.UNS, tecnología educativa, docentes, diseño gráfico y producción audiovisual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="758" width="680" height="86" as="geometry"/></mxCell><mxCell id="31" value="RES-09" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="844" width="135" height="86" as="geometry"/></mxCell><mxCell id="32" value="De control académico" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="185" y="844" width="300" height="86" as="geometry"/></mxCell><mxCell id="33" value="La solución debe conservar evidencia académica y administrativa suficiente para respaldar evaluación, aprobación, deserción, reportes estadísticos y certificación de cursos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="844" width="680" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
