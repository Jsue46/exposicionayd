                <mxCell id="8" value="Descripción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="230" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Secretaria académica del Departamento de Economia y coordinadora histórica de la Diplomatura en Gerenciamiento Empresarial. Toma decisiones estratégicas, pedagógicas y administrativas sobre la evolución del programa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="230" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Necesidades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="318" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="- Conocer con precisión las necesidades de los destinatarios • Reducir la deserción del programa • Ampliar la zona de influencia de la propuesta • Innovar en tecnología y formatos educativos • Mantener continuidad de los programas actuales" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="318" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="Dolor / Miedo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="406" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="*&quot;Si la diplomatura deja de responder a las necesidades reales del medio empresarial, pierde pertinencia y prestigio.&quot;*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="406" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="Métricas Clave" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="494" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="- Reduccion de deserción • Aumento de alumnos fuera de Bahía Blanca • Actualizacion anual de contenidos • Satisfaccion académica &gt;= 4/5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="494" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="QA Principal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
