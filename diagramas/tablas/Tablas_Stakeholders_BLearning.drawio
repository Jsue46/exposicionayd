                    <mxGeometry x="40" y="406" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="*&quot;Si estudiar a distancia consume demasiado tiempo o la plataforma es confusa, abandono aunque el contenido sea valioso.&quot;*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1">
