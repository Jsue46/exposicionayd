                </mxCell>
                <mxCell id="11" value="- LMS estable para alojar cursos • Gestion clara de inscripciónes e información académica • Herramientas de comunicación docente-alumno • Reportes estadísticos útiles para evaluar el proyecto • Recursos visuales y pedagógicos bien integrados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
