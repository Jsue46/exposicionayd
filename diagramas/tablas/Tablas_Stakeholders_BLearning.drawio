                    <mxGeometry x="40" y="406" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="*&quot;Si la plataforma o la gestión operativa fallan, los cursos actuales y la expansion futura quedan comprometidos.&quot;*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
