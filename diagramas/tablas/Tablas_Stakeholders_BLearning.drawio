                </mxCell>
                <mxCell id="8" value="Descripción" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="230" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Rol responsable de la infraestructura tecnológica educativa y de la plataforma LMS usada para mediar la educación a distancia. En el caso participa dentro del equipo multidisciplinario que hace posible la oferta b-learning." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="230" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Necesidades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="318" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="- Plataforma LMS escalable y mantenible • Continuidad operativa de los cursos actuales • Capacidad para incorporar nuevos programas • Soporte a foros, materiales, videos, grupos y reportes • Seguridad y administración adecuada de usuarios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="318" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="Dolor / Miedo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="406" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="*&quot;Si la plataforma no escala o queda obsoleta, la estrategia institucional de EaD no se puede sostener.&quot;*" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="406" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="Métricas Clave" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="494" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="- Disponibilidad mensual &gt;= 99.5% • Tiempo de respuesta aceptable en el LMS • Nuevos cursos habilitados sin afectar cursos activos • Incidentes criticos resueltos &lt;= 4 horas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="280" y="494" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="QA Principal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
