                <mxCell id="11" value="- Coherencia entre cursos y módulos • Contenidos alineados al gerenciamiento empresarial • Coordinación fluida con docentes y Continuar.UNS • Informacion para ajustar la oferta académica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
