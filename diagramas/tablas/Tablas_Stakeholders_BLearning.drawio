                    <mxGeometry x="40" y="230" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Gerentes, mandos medios, profesionales independientes, emprendedores, directivos de pymes, propietarios y particulares que cursan la diplomatura o programas/cursos asociados. Son el cliente final del programa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="280" y="230" width="300" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="Necesidades" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="318" width="240" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="- Flexibilidad para combinar estudio, trabajo y vida adulta • Acceso claro a clases, materiales, foros y actividades • Comunicación asincrónica con docentes y compañeros • Evaluacion transparente y certificación • Plataforma fácil de usar desde distintas ubicaciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1">
