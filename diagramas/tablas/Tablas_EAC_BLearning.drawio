pace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="484" width="260" height="82" as="geometry"/></mxCell><mxCell id="15" value="Seguridad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="484" width="760" height="82" as="geometry"/></mxCell><mxCell id="16" value="CAR-06" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="566" width="260" height="82" as="geometry"/></mxCell><mxCell id="17" value="Modificabilidad y escalabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="566" width="760" height="82" as="geometry"/></mxCell><mxCell id="18" value="CAR-07" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="648" width="260" height="82" as="geometry"/></mxCell><mxCell id="19" value="Trazabilidad y auditabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="648" width="760" height="82" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tbl2" name="EAC"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="EAC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F3A33" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1155" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFA;strokeColor=#B7D7C2;arcSize=6;shadow=1" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1195" height="1510" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="102" width="95" height="54" as="geometry"/></mxCell><mxCell id="5" value="Categoría" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="102" width="190" height="54" as="geometry"/></mxCell><mxCell id="6" value="Escenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="102" width="760" height="54" as="geometry"/></mxCell><mxCell id="7" value="Prioridad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="102" width="110" height="54" as="geometry"/></mxCell><mxCell id="8" value="EAC-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="156" width="95" height="142" as="geometry"/></mxCell><mxCell id="9" value="Disponibilidad y confiabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="156" width="190" height="142" as="geometry"/></mxCell><mxCell id="10" value="Fuente: alumno o docente. Estímulo: intenta acceder a un curso virtual durante el período activo de clases. Artefacto: plataforma LMS y aula virtual. Entorno: operación normal del programa. Respuesta: el sistema permite ingresar al curso, consultar materiales y participar en actividades sin interrupción. Medida: disponibilidad mensual mayor o igual a 99.5%." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="156" width="760" height="142" as="geometry"/></mxCell><mxCell id="11" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="156" width="110" height="142" as="geometry"/></mxCell><mxCell id="12" value="EAC-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="298" width="95" height="142" as="geometry"/></mxCell><mxCell id="13" value="Disponibilidad y continuidad operativa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="298" width="190" height="142" as="geometry"/></mxCell><mxCell id="14" value="Fuente: equipo de Continuar.UNS. Estímulo: se realiza una mejora, migración o incorporación de nuevos programas. Artefacto: plataforma LMS y servicios de educación a distancia. Entorno: programas actuales en funcionamiento. Respuesta: los cursos activos continúan operando sin suspensión general del servicio. Medida: interrupción planificada menor o igual a 2 horas y comunicada previamente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="298" width="760" height="142" as="geometry"/></mxCell><mxCell id="15" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="298" width="110" height="142" as="geometry"/></mxCell><mxCell id="16" value="EAC-03" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="440" width="95" height="142" as="geometry"/></mxCell><mxCell id="17" value="Desempeño" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="440" width="190" height="142" as="geometry"/></mxCell><mxCell id="18" value="Fuente: alumno. Estímulo: consulta materiales, foros o actividades de una clase virtual. Artefacto: aula virtual, repositorio de contenidos y servicios LMS. Entorno: horario de alta concurrencia académica. Respuesta: el sistema carga la información solicitada y permite continuar la actividad. Medida: tiempo de respuesta menor o igual a 3 segundos para consultas comunes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="440" width="760" height="142" as="geometry"/></mxCell><mxCell id="19" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="440" width="110" height="142" as="geometry"/></mxCell><mxCell id="20" value="EAC-04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="582" width="95" height="142" as="geometry"/></mxCell><mxCell id="21" value="Usabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="582" width="190" height="142" as="geometry"/></mxCell><mxCell id="22" value="Fuente: alumno adulto con responsabilidades laborales. Estímulo: necesita inscribirse, ingresar al curso, consultar materiales o participar en foros sin acompañamiento presencial. Artefacto: portal de inscripción y aula virtual. Entorno: acceso remoto desde distintas ubicaciones. Respuesta: el sistema guía la operación con navegación clara y mensajes comprensibles. Medida: completar una tarea principal en menos de 5 minutos sin asistencia externa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="582" width="760" height="142" as="geometry"/></mxCell><mxCell id="23" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="582" width="110" height="142" as="geometry"/></mxCell><mxCell id="24" value="EAC-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="724" width="95" height="142" as="geometry"/></mxCell><mxCell id="25" value="Interoperabilidad y compatibilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="724" width="190" height="142" as="geometry"/></mxCell><mxCell id="26" value="Fuente: equipo operativo o docente autor. Estímulo: publica o reutiliza contenidos educativos bajo estándares soportados por la plataforma. Artefacto: LMS, sistema de contenidos y objetos de aprendizaje. Entorno: preparación o actualización de cursos. Respuesta: el sistema acepta, organiza y conserva contenidos compatibles con estándares educativos. Medida: compatibilidad mantenida con SCORM, AICC, metadatos y recursos del LMS vigente." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="724" width="760" height="142" as="geometry"/></mxCell><mxCell id="27" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="724" width="110" height="142" as="geometry"/></mxCell><mxCell id="28" value="EAC-06" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="866" width="95" height="142" as="geometry"/></mxCell><mxCell id="29" value="Seguridad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="866" width="190" height="142" as="geometry"/></mxCell><mxCell id="30" value="Fuente: usuario no autorizado. Estímulo: intenta acceder a información académica, administrativa o evaluaciones de alumnos. Artefacto: LMS, módulo de usuarios y registros académicos. Entorno: operación normal. Respuesta: el sistema valida identidad, restringe permisos y bloquea accesos no autorizados. Medida: 100% de acceso a datos sensibles requiere autenticación y rol autorizado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="866" width="760" height="142" as="geometry"/></mxCell><mxCell id="31" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="866" width="110" height="142" as="geometry"/></mxCell><mxCell id="32" value="EAC-07" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1008" width="95" height="142" as="geometry"/></mxCell><mxCell id="33" value="Modificabilidad y escalabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="1008" width="190" height="142" as="geometry"/></mxCell><mxCell id="34" value="Fuente: autoridades UNS o equipo de Continuar.UNS. Estímulo: se solicita incorporar 3 programas de licenciatura y 3 de posgrado en un ciclo académico anual. Artefacto: plataforma LMS, configuración de cursos y estructura de programas. Entorno: crecimiento institucional de la educación a distancia. Respuesta: el sistema permite agregar programas sin rediseñar la arquitectura ni afectar cursos activos. Medida: incorporación de un nuevo programa mediante configuración y parametrización, sin cambios estructurales mayores." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="1008" width="760" height="142" as="geometry"/></mxCell><mxCell id="35" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="1008" width="110" height="142" as="geometry"/></mxCell><mxCell id="36" value="EAC-08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1150" width="95" height="142" as="geometry"/></mxCell><mxCell id="37" value="Modificabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="1150" width="190" height="142" as="geometry"/></mxCell><mxCell id="38" value="Fuente: coordinadora del programa o coordinadores académicos. Estímulo: se actualizan contenidos, módulos, cursos sueltos o estructura de la oferta académica. Artefacto: catálogo académico, cursos LMS y materiales educativos. Entorno: actualización anual o mejora del programa. Respuesta: el sistema permite modificar la oferta sin afectar la trazabilidad histórica de cohortes anteriores. Medida: cambio aplicado manteniendo historial académico y versiones previas consultables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="1150" width="760" height="142" as="geometry"/></mxCell><mxCell id="39" value="Media" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="1150" width="110" height="142" as="geometry"/></mxCell><mxCell id="40" value="EAC-09" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1292" width="95" height="142" as="geometry"/></mxCell><mxCell id="41" value="Trazabilidad y auditabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="1292" width="190" height="142" as="geometry"/></mxCell><mxCell id="42" value="Fuente: coordinadora del programa o equipo operativo. Estímulo: solicita analizar aprobación, participación, deserción, perfil de alumnos o alcance geográfico. Artefacto: registros académicos, administrativos y reportes estadísticos. Entorno: evaluación del programa y mejora continua. Respuesta: el sistema presenta datos confiables para análisis y toma de decisiones. Medida: reporte generado en menos de 1 minuto con datos de cohortes, alumnos, participación y resultados académicos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="1292" width="760" height="142" as="geometry"/></mxCell><mxCell id="43" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="1292" width="110" height="142" as="geometry"/></mxCell><mxCell id="44" value="EAC-10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1434" width="95" height="142" as="geometry"/></mxCell><mxCell id="45" value="Trazabilidad académica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="145" y="1434" width="190" height="142" as="geometry"/></mxCell><mxCell id="46" value="Fuente: equipo operativo o coordinación académica. Estímulo: necesita validar si un alumno cumple condiciones de aprobación y certificación. Artefacto: registros de actividades, foros, evaluaciones y trabajo final. Entorno: cierre de curso. Respuesta: el sistema muestra evidencia suficiente para respaldar la acreditación. Medida: trazabilidad completa de participación y evaluación por alumno en menos de 1 minuto." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="335" y="1434" width="760" height="142" as="geometry"/></mxCell><mxCell id="47" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="1095" y="1434" width="110" height="142" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
