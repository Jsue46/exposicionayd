<mxfile host="app.diagrams.net" modified="2026-05-05T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="tbl1" name="Características de calidad seleccionadas"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="808" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Características de calidad seleccionadas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F3A33" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1020" height="46" as="geometry"/></mxCell><mxCell id="3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FCFA;strokeColor=#B7D7C2;arcSize=6;shadow=1" vertex="1" parent="1"><mxGeometry x="30" y="84" width="1060" height="664" as="geometry"/></mxCell><mxCell id="4" value="ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="102" width="260" height="54" as="geometry"/></mxCell><mxCell id="5" value="Característica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="310" y="102" width="760" height="54" as="geometry"/></mxCell><mxCell id="6" value="CAR-01" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#065F46;fontStyle=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="156" width="260" height="82" as="geometry"/></mxCell><mxCell id="7" value="Disponibilidad y confiabilidad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7CBB6;fontColor=#1F2937;fontStyle=0;al