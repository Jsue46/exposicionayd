                </mxCell>
                <mxCell id="10" value="Fuente: alumno o docente. Estímulo: intenta acceder a un curso virtual durante el período activo de clases. Artefacto: plataforma LMS y aula virtual. Entorno: operación normal del programa. Respuesta: el sistema permite ingresar al curso, consultar materiales y participar en actividades sin interrupción. Medida: disponibilidad mensual mayor o igual a 99.5%." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="410" y="142" width="220" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="Alta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
