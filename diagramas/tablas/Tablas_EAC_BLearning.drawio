                </mxCell>
                <mxCell id="18" value="Fuente: alumno. Estímulo: consulta materiales, foros o actividades de una clase virtual. Artefacto: aula virtual, repositorio de contenidos y servicios LMS. Entorno: horario de alta concurrencia académica. Respuesta: el sistema carga la información solicitada y permite continuar la actividad. Medida: tiempo de respuesta menor o igual a 3 segundos para consultas comunes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
