                <mxCell id="12" value="EAC-02" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" parent="1" vertex="1">
